# ---------- App ----------
APP_NAME=InterviewPilot AI
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
# Docker Compose maps Postgres to host port 5433 to avoid clashing with a local install.
DATABASE_URL=postgresql+psycopg://interviewpilot:interviewpilot@localhost:5433/interviewpilot
REDIS_URL=redis://localhost:6380/0

# ---------- AI ----------
# AI_PROVIDER: "openai" | "mock" | "auto"
#   auto -> uses openai when OPENAI_API_KEY is set, otherwise falls back to mock.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---------- Auth provider ----------
# AUTH_PROVIDER: "local" | "clerk"
AUTH_PROVIDER=local
CLERK_JWKS_URL=
CLERK_ISSUER=

# ---------- Email verification (OTP) ----------
# Set to false to skip verification entirely (useful for automated tests).
REQUIRE_EMAIL_VERIFICATION=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Email delivery ----------
# EMAIL_PROVIDER: "auto" | "smtp" | "console"
#   auto -> uses SMTP when SMTP_HOST is set, otherwise logs the code to the backend
#           console so you can complete sign-up without a mail server.
EMAIL_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=InterviewPilot AI <no-reply@interviewpilot.ai>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
#
# Gmail example (requires a Google App Password, NOT your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_USE_TLS=true

# ---------- Storage ----------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
